<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Our Father</title>

<style>
  body {
    background: #6b6c6b;
    margin: 0;
    padding: 20px;
    font-family: Arial, sans-serif;
  }

  h1, h3 {
    text-align: center;
    color: #fff;
  }

  /* Prayer box styling with proper centering and max-width */
  p.prayer-box {
    max-width: 500px;
    margin: 20px auto;
    padding: 30px;
    background: #3a4356;
    color: #fff;
    border-radius: 8px;
    text-align: center;
    line-height: 1.8;
    box-shadow: 0 0 20px rgba(0,229,255,.5);
  }

  /* Styling to make the buttons look nice on the screen */
  .btn {
    background-color: #007bff;
    color: white;
    border: none;
    padding: 10px 15px;
    font-size: 16px;
    border-radius: 4px;
    cursor: pointer;
    font-weight: bold;
    text-decoration: none;
    display: inline-block;
    margin: 5px;
  }

  .btn:hover {
    background-color: #0056b3;
  }

  /* PRINT RULES */
  @media print {
    /* Hide the buttons on the paper */
    .btn {
      display: none !important;
    }

    body {
      background: white;
      color: black;
    }

    p.prayer-box {
      background: none;
      color: black;
      box-shadow: none;
      max-height: 100vh; 
      overflow: hidden; /* Prevents spilling onto page 2 */
    }
  }

  /* Shrink the default printer margins to fit more on one page */
  @page {
    margin: 10mm; 
  }
</style>
</head>
<body>

<div style="text-align: center;">
  <button class="btn print-btn" onclick="window.print()">🖨 Print Page</button>
  <a href="https://gmw1-9.github.io/Our-Father/" class="btn link-btn" target="_blank">Visit Our Father Page</a>
</div>
   
<h1>Our Father</h1>
<h3>Also known as <em>The Lord's Prayer</em></h3>

<p class="prayer-box">
  Our Father
  <br>Who art in Heaven
  <br>Hallowed be thy Name
  <br>Thy Kingdom come
  <br>Thy Will be done
  <br>On Earth as it is in Heaven
  <br>Give us this day our daily bread
  <br>And forgive us our trespasses 
  <br>As we forgive those who trespass against us
  <br>Lead us not into temptation  
  <br>But Deliver Us from evil
  <br><br>Amen.
</p>

</body>
</html>
